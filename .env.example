# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API
#
# Both values are safe to ship in the client bundle — the anon key is public and
# is constrained by Row Level Security. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Origin of the published Storybook (no trailing slash).
# When set, editors can paste a story id (e.g. components-button--primary)
# instead of a full URL.
# VITE_STORYBOOK_URL=http://localhost:6006
